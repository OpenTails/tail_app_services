# Copy this file to `.env` and adjust as needed.
# Real environment variables take precedence over values in `.env`.

# --- Server ---
PORT=3000
UPSTREAM_URL=https://thetailcompany.com/wp-json/wc/store/v1/products?tag=select&per_page=100
BLOG_UPSTREAM_URL=https://thetailcompany.com/wp-json/wp/v2/posts?per_page=10&orderby=date&order=desc&_embed=wp:featuredmedia
UPSTREAM_TIMEOUT_MS=10000

# --- Cache ---
CACHE_TTL_MS=300000
CACHE_MAX_STALE_MS=86400000

# --- Placeholders ---
# Set to false to skip downloading images and emitting ThumbHashes.
THUMBHASH_ENABLED=true

# --- Selection ---
DEFAULT_COUNT=10
MAX_COUNT=100

# --- Sentry ---
# Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Defaults to tailcompany-wp-proxy@<version>.
# SENTRY_RELEASE=tailcompany-wp-proxy@1.0.0
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_DEBUG=false

# --- Logging ---
RUST_LOG=info
